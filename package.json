{
  "name": "watershed-lookup",
  "version": "0.1.0",
  "description": "Postal code to watershed, ecoregion, first-stewards link and Sentinel-2 view. Open pipeline; the data stays with you.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": ["dist", "scripts", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "fetch-data": "node scripts/fetch-data.mjs",
    "build-index": "node --max-old-space-size=8192 scripts/build-index.mjs",
    "build": "tsc -p .",
    "prepare": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p . && node --test test/*.test.mjs"
  },
  "optionalDependencies": {
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "repository": { "type": "git", "url": "https://github.com/johnellison/watershed-lookup.git" }
}
